{{!
    @template theme_ucsf/frontpage-main

    This is the main content template for the frontpage.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * frontpagehero - The URL to the frontpage hero image.

    Example context (json):
    {
        "frontpagehero": "https://courses.ucsf.edu/theme/image.php/ucsf/theme_ucsf/..."
    }
}}
<div class="row align-items-center">
    <div class="col-12 col-lg-6 d-none d-sm-block text-center">
        <img src="{{{frontpagehero}}}" class="img-fluid" alt="">
    </div>
    <div class="col-12 col-lg-6 mt-sm-6">
        <h1><span>Collaborative</span> <span class="text-nowrap">Learning Environment</span></h1>
        <p class="lead">UCSF's platform for online teaching and learning.</p>
        <div class="mt-2">
            <a class="btn btn-outline-primary btn-lg" href="/login/index.php">
                Sign in with UCSF SSO
                <span class="fa fa-arrow-right fa-sm"></span>
            </a>
        </div>
        <div class="mt-2">
            <a href="https://tiny.ucsf.edu/educationithelp" class="troubleshooting">Trouble signing in?</a>
        </div>
    </div>
</div>
