{{!
    @template theme_ucsf/frontpage-main

    This is the main content template for the frontpage.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * frontpagehero - The URL to the frontpage hero image.
    * frontpageherosmall - The URL to the frontpage hero image for smaller/mobile screen sizes.

    Example context (json):
    {
        "frontpagehero": "http://imagurl",
        "frontpageherosmall": "http://imageurl"
    }
}}
<div class="row align-items-center frontpage-main-content">
    <div class="col-12 col-lg-5 text-center">
        <img src="{{{frontpageherosmall}}}" class="d-md-none img-fluid float-start" alt="">
        <img src="{{{frontpagehero}}}" class="d-none d-md-inline img-fluid float-start" alt="">
    </div>
    <div class="col-12 col-lg-7 mt-4 mt-lg-0">
        <h1>Collaborative<br>Learning Environment</h1>
        <p class="lead">UCSF's platform for online teaching and learning.</p>
        <div class="mt-2">
            <a class="btn btn-outline-primary btn-lg cta" href="/login/index.php">
                Sign in with UCSF SSO
                <span class="fa fa-arrow-right fa-sm"></span>
            </a>
        </div>
        <div class="mt-2">
            <a href="https://tiny.ucsf.edu/educationithelp" class="troubleshooting">Trouble signing in?</a>
        </div>
    </div>
</div>
